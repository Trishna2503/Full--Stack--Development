const express = require('express');
const app = express();
const PORT = 3000;

// Middleware to parse incoming JSON payloads
app.use(express.json());

// Middleware to parse URL-encoded form data (from HTML forms)
app.use(express.urlencoded({ extended: true }));

// 1. Handling GET Requests
app.get('/api/users', (req, res) => {
    // Access query parameters if any (e.g., /api/users?role=admin)
    const userRole = req.query.role;

    const mockData = [
        { id: 1, name: 'Alice', role: 'admin' },
        { id: 2, name: 'Bob', role: 'user' }
    ];

    res.status(200).json({
        message: "Data retrieved successfully!",
        filterApplied: userRole || "none",
        data: mockData
    });
});

// 2. Handling POST Requests
app.post('/api/users', (req, res) => {
    // Access the data sent in the request body
    const { name, role } = req.body;

    if (!name || !role) {
        return res.status(400).json({ error: "Missing required fields: 'name' and 'role'" });
    }

    // Simulate creating a new resource
    const newUser = {
        id: Math.floor(Math.random() * 1000),
        name,
        role
    };

    res.status(201).json({
        message: "User created successfully!",
        data: newUser
    });
});

// Start the server
app.listen(PORT, () => {
    console.log(`Express server running at http://localhost:${PORT}`);
});
